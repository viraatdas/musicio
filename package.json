{
  "name": "musicio",
  "version": "0.0.5",
  "description": "Cyberpunk music desktop app - Spotify & YouTube Music in one place",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder --mac",
    "build:dmg": "electron-builder --mac dmg"
  },
  "author": "viraatdas",
  "license": "MIT",
  "build": {
    "appId": "com.musicio.app",
    "productName": "Musicio",
    "files": [
      "main.js",
      "preload.js",
      "preload-webview.js",
      "preload-auth.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "dmg": {
      "title": "Musicio",
      "backgroundColor": "#0a0a0f",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v38.2.0+wvcus",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.14.1",
    "cross-fetch": "^4.1.0"
  }
}
